%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dfcde8cf81f3f774f8943da8671fa002, type: 3}
  m_Name: ShowcaseCatalog
  m_EditorClassIdentifier: ConfusedGameDev.Vfx.Showcase::ConfusedGameDev.Vfx.Showcase.VfxShowcaseCatalog
  categories:
  - name: Projectiles
    objects: 0
    items:
    - name: Arcane Missile
      description: Crystal gems orbit the flight axis while flying forward, each
        leaving a spiral ribbon of rune packets and small diamond glints. `Hit()`
        scatters runes and crystals.
      display: 0
      prefab: {fileID: 4172131477067443048, guid: 85849016a4ad0d247b515b3f13d4cac0, type: 3}
      height: 0
      scale: 1
    - name: Electric Magic Arrow Strike
      description: A golden arrow with four hooked blades charges inside a turning
        sigil, wrapped in forking lightning. It flies with crackling trails, and
        on contact erodes from the tip while a lightning web and two broken shock
        rings burst from the point of impact.
      display: 0
      prefab: {fileID: 4807099972905464779, guid: e8f93cd7a8a04864ba5243144cde218b, type: 3}
      height: 0
      scale: 1
    - name: Fireball
      description: 
      display: 0
      prefab: {fileID: 5330056857283381539, guid: 8c50e6cbb6792244ca5134d6e10019fa, type: 3}
      height: 0
      scale: 1
    - name: Frost Wheel
      description: A ring of ice with nine crystal teeth spins as it flies, face-on
        to the flight axis, shedding frost. `Hit()` breaks it into curved shards.
      display: 0
      prefab: {fileID: 3153809624743492405, guid: 39f2b40b4c385c248a9d5ad8d442baf6, type: 3}
      height: 0
      scale: 1
    - name: Ice Shard
      description: A faceted cluster of ice lances flying forward, shedding tumbling
        flecks and thin frost streams. `Hit()` shatters it into spinning crystals.
      display: 0
      prefab: {fileID: 4708443238124081923, guid: 575174c8554e3be45a7866eb58a4c019, type: 3}
      height: 0
      scale: 1
    - name: Plasma Bolt
      description: A bright dart wrapped in jittering electric ribbons, with thin
        sparks behind it. `Hit()` ends it in a branching discharge.
      display: 0
      prefab: {fileID: 1163509558678392742, guid: e0dc1153f1edb2d448c62362058d65f4, type: 3}
      height: 0
      scale: 1
    - name: Shadow Glaive
      description: A curved blade rolls around the flight axis with three fading
        afterimages behind it. `Hit()` throws three arcs forward, which dissolve.
      display: 0
      prefab: {fileID: 5571458604098538566, guid: 4425dcb3d2d814f4ba8863ab5ed85cf2, type: 3}
      height: 0
      scale: 1
    - name: Spiral Gale
      description: Seven twisting ribbons of wind form a translucent spear with thin
        wind streaks behind it. `Hit()` unwinds eight spiralling ribbons forward.
      display: 0
      prefab: {fileID: 8937571906933124524, guid: a4339dc74be550f4cb58d490f9f6c398, type: 3}
      height: 0
      scale: 1
  - name: Weapon effects
    objects: 0
    items:
    - name: Weapon Smear
      description: A swung blade leaves a clear blue ribbon with fine lines along
        it, a soft glow near the tip and a bright cutting edge. Each part fades within
        0.18s, so a slow blade leaves almost nothing.
      display: 2
      prefab: {fileID: 2261860349132047793, guid: 76479fa00145e174a915f16341c57025, type: 3}
      height: 0
      scale: 1
    - name: Spatial Smear
      description: A swung blade leaves a clear ribbon that bends the scene behind
        it into fine bands, with a faint rim and a thin bright edge. Each part fades
        within 0.18s, so a slow blade leaves almost nothing.
      display: 2
      prefab: {fileID: 8348732267992704883, guid: 3dba9594ac49e3e4abe5170b9ee048da, type: 3}
      height: 0
      scale: 1
    - name: Azure Sweep
      description: A blue-white blade of light sweeps almost a full turn around the
        origin at a height of 1, holds for a moment, and its tail runs up and swallows
        the head.
      display: 3
      prefab: {fileID: 2915399136609425113, guid: 38d4452f529596042ae9c2f3bd3691fe, type: 3}
      height: 0
      scale: 1
    - name: Spatial Sweep
      description: A clear blade sweeps almost a full turn around the origin at a
        height of 1. The scene behind it stretches along the swing and breaks into
        fast bands, and a thin bright edge leads it, then the tail catches up and
        the distortion closes.
      display: 3
      prefab: {fileID: 2129146884728293955, guid: ffa2e62cc5ba9544d999cda953319c1e, type: 3}
      height: 0
      scale: 1
  - name: Beams
    objects: 0
    items:
    - name: Arc Ray
      description: Jagged arcs with short forks join the two ends, redrawn 18 times
        a second, while small coronas crackle around both ends and needles of light
        leave them. `quantity` sets how many arcs run.
      display: 1
      prefab: {fileID: 3597827924496516856, guid: dded3feb14021424fac6e00d6b402b6c, type: 3}
      height: 0
      scale: 1
    - name: Charged Beam
      description: Light spirals into the source for about 1.5 seconds, then a lance
        of five blades shoots across and keeps firing, with shock rings at the target.
        It charges only once; `Play()` charges again.
      display: 1
      prefab: {fileID: 6249198419229108679, guid: 653f6cd3d201dbf47ac6f55817be8575, type: 3}
      height: 0
      scale: 1
    - name: Continuous Beam
      description: A thin ray runs between two fixed points with bright filaments
        winding around it. The source end shows a ring aperture and the target end
        throws sparks.
      display: 1
      prefab: {fileID: 1639417675160517816, guid: 9a3d6cafb3beec4438b64d95ef3ebbbe, type: 3}
      height: 0
      scale: 1
    - name: Pulse Beam
      description: Glowing packets swell along a ray and rings run forward over it,
        keeping their shape at any length. `quantity` sets how many packets fit in
        the range.
      display: 1
      prefab: {fileID: 8803171820751248748, guid: 2a8a6bf9c4c1085448b9a819dfe64c0c, type: 3}
      height: 0
      scale: 1
    - name: Radiant Beam
      description: A bright shaft with a soft sheath joins two turning seals of seven
        petals, with motes drifting off both. When it stops the seals drop away petal
        by petal.
      display: 1
      prefab: {fileID: 8587865653346148916, guid: ce57b03f9fc71d14e9ae2b6ec5fe75d1, type: 3}
      height: 0
      scale: 1
    - name: Soul Siphon
      description: Orbs of dark energy with trailing cones stream from the target
        back to the source along three twisting strands, between two rings of arc
        segments. After `Stop()` no orbs are born and the ones in flight finish their
        way home. `quantity` sets the orbs per cycle.
      display: 1
      prefab: {fileID: 7308380557749292327, guid: 424d8653032bca9469268e158021e738, type: 3}
      height: 0
      scale: 1
    - name: Venom Stream
      description: Teardrop slugs of venom race from the source to the target and
        splash there in tongues and falling drops. After `Stop()` no slugs are born
        and the ones in flight finish. `quantity` sets the slugs per cycle.
      display: 1
      prefab: {fileID: 8400128317338674978, guid: 20fb41d88785ca14eb55e3601d4152cf, type: 3}
      height: 0
      scale: 1
  - name: Ground effects
    objects: 0
    items:
    - name: Arcane Matrix
      description: Nine crystals with small rings bob over a square lattice and take
        quarter turns together, while diamonds rise from the lattice crossings. In
        its ending the crystals sink and the ground cracks into tiles.
      display: 4
      prefab: {fileID: 7620784689694499471, guid: 5f9c8f8f41b6f554fb14b878de509943, type: 3}
      height: 0
      scale: 1
    - name: Binding Curse
      description: Curved hooked bands rise from a three-armed sigil and tighten
        in turn around whatever stands at its centre. In its ending they loosen,
        droop and rot away.
      display: 4
      prefab: {fileID: 341583785175224854, guid: 4896b6a61fa5a9746a20f1f37a4b9e43, type: 3}
      height: 0
      scale: 1
    - name: Burning Ground
      description: A five-bladed flame wheel turns over glowing cracks while tongues
        of fire lick up and die away. Its ending burns the ground out to ash, and
        unlike the frozen sigils it keeps moving as it does.
      display: 4
      prefab: {fileID: 8474977954166408591, guid: 818a34cd214138244a44a7d76b080c2b, type: 3}
      height: 0
      scale: 1
    - name: Frost Field
      description: A snowflake sigil lights up outward while six-pointed ice flecks
        glint just above it. Its ending cracks the ground into tumbling tiles.
      display: 4
      prefab: {fileID: 3750437481140737830, guid: e31d88a0c92848e459060c96174187ea, type: 3}
      height: 0
      scale: 1
    - name: Healing Field
      description: A flowering sigil glows in rings that spread outward while small
        crosses drift up from it. Its ending draws everything back to the centre.
      display: 4
      prefab: {fileID: 3346447202755806992, guid: cfbfce97d8f316e44bee1140ea7dc947, type: 3}
      height: 0
      scale: 1
    - name: Quicksand Seal
      description: Dunes rise in turn inside a triangular seal and collapse inward,
        with fine sand streaming along each slide. In its ending the sand sinks into
        the seal.
      display: 4
      prefab: {fileID: 8975107623579817347, guid: 70ee9cf2e7af7d94bb200611562b31e8, type: 3}
      height: 0
      scale: 1
    - name: Thorn Crown
      description: Thorned vines climb from a leaf sigil, leaves opening along them,
        around a seven-petalled blossom. In its ending the vines wither back to the
        ground.
      display: 4
      prefab: {fileID: 1413278815273569500, guid: 31cbb8d64901004499b4b522644f6320, type: 3}
      height: 0
      scale: 1
    - name: Venom Pool
      description: Bubbles swell and burst on a three-lobed pool, each throwing a
        spray of droplets, with low mist drifting over it. In its ending every bubble
        pops in turn.
      display: 4
      prefab: {fileID: 1272924927790061978, guid: 4de59ac6906b7854499b22bb7a9070a2, type: 3}
      height: 0
      scale: 1
    - name: Magic Barrier
      description: Runic Mesh Barrier, ported from [00gamedevs](https://00gamedevs.com)
        `magic-barrier` (MIT).
      display: 4
      prefab: {fileID: 5980199927550301450, guid: 78f1691b737c9494fae8b1ddd054dc53, type: 3}
      height: 0
      scale: 1
    - name: Spell Indicator Circle
      description: 'A circle on the ground, centered on the object. It fills from
        the center to warn of a coming attack, flashes its edge once for 0.06s, and
        fades in 0.09s. It only draws: it triggers no damage or collisions, and finishing
        means invisible, not that the attack lands. Keep attack timing in the game.'
      display: 4
      prefab: {fileID: 706019182272495489, guid: c38f3328d8d4f584db79ccdba078acf9, type: 3}
      height: 0
      scale: 1
    - name: Spell Indicator Sector
      description: 'A sector on the ground, with its apex at the object''s origin,
        opening around its forward axis. It fills from the center to warn of a coming
        attack, flashes its edge once for 0.06s, and fades in 0.09s. It only draws:
        it triggers no damage or collisions, and finishing means invisible, not that
        the attack lands. Keep attack timing in the game.'
      display: 4
      prefab: {fileID: 6913661659226280619, guid: c985ffe15fe43ef48b426ca40ef91e3a, type: 3}
      height: 0
      scale: 1
    - name: Darkchain Detonation
      description: 'Two sigils open, twelve chains lash between them, and ink, smoke
        and sparks spiral into a black orb that pulses thirty times. It collapses,
        then detonates: jets, lightning, torn pressure sheets and a black shock ring
        throw the chains apart, and the scene behind ripples.'
      display: 4
      prefab: {fileID: 6062321377734627180, guid: facb18f17ba0d8545a25b6d5f489f4ad, type: 3}
      height: 0
      scale: 1
    - name: Energy Burst
      description: Lightning Arc Burst, ported from [00gamedevs](https://00gamedevs.com)
        `energy-burst` (MIT).
      display: 4
      prefab: {fileID: 4013477262936112212, guid: aa9263379633b4a4c8bcee418e4f53a9, type: 3}
      height: 1.2
      scale: 1
    - name: Frost Lance Rain
      description: Ice lances drop from the sky one after another, shatter on landing
        and leave patches of frost.
      display: 4
      prefab: {fileID: 356694293493465035, guid: 80ec81d4d001df64d89ba13cf54972bc, type: 3}
      height: 0
      scale: 1
    - name: Golden Chain Rain
      description: Three waves of gold chains fall from rippling golden pools in
        the air, each driving an arrowhead half into the ground. Glowing cracks branch
        from each landing and shed floating chips, then the chains dissolve from
        the top down into gold flakes.
      display: 4
      prefab: {fileID: 3502934432260889705, guid: 78e95206c1b17ed4f8c4a53f76b32e20, type: 3}
      height: 0
      scale: 1
    - name: Magma Fissure
      description: A glowing crack runs along the ground, heaves dark rocks up on
        both sides and spits embers.
      display: 4
      prefab: {fileID: 8871778247760929126, guid: 42ec815cd0f52194f8d4c44b033661a8, type: 3}
      height: 0
      scale: 1
    - name: Sacred Relic Descent
      description: 'A white-gold sigil of five layers draws itself and turns. A pyramid
        relic falls from above and buries its tip, with a water-like shock, cracks,
        rocks and dust. Then five healing waves roll out two seconds apart, each
        with a raised ring of smoke. It only draws: no healing, collision, terrain
        or camera work.'
      display: 4
      prefab: {fileID: 6102979206592850900, guid: 89491b32bc7d5ca44a23c85ea86b85e4, type: 3}
      height: 0
      scale: 1
    - name: Shockwave
      description: A ring of dust punches outward, rolls up in large billows, and
        small stones fall back to the ground. The last 1.26s of the dust, sparks
        and stones ripple and break up.
      display: 4
      prefab: {fileID: 7501584226234383829, guid: 885b2c14d711b6844882d2faae97159a, type: 3}
      height: 0
      scale: 1
    - name: Thunder Strike
      description: Electric light gathers overhead, a blue-white bolt splits down
        through it, and the strike throws sparks across the ground.
      display: 4
      prefab: {fileID: 6419216390779768977, guid: 212f1ea09704d11498a434babc8e6f61, type: 3}
      height: 0
      scale: 1
  - name: Area effects
    objects: 0
    items:
    - name: Dust Devil
      description: Rolling sand billows and sheets wind upward around an open middle,
        with grit flying beside them. Its ending lets the sand fall.
      display: 4
      prefab: {fileID: 6056936511133028200, guid: e96307599557b1e41ad4e094c664e911, type: 3}
      height: 1.4
      scale: 1
    - name: Energy Vortex
      description: Glowing bands wind upward, with charge running along them, while
        rune motes ride rings up the open middle.
      display: 4
      prefab: {fileID: 3437158465671422539, guid: 8ff626142f77e454e82efcf9d1c9f699, type: 3}
      height: 1.4
      scale: 1
    - name: Fire Vortex
      description: Orange flame sheets wind upward and light the dust beneath them.
        Its ending burns the sheets away to dark embers.
      display: 4
      prefab: {fileID: 5204735857200028715, guid: e5b5a4c854a64b947ad1bf2c6e228525, type: 3}
      height: 1.4
      scale: 1
    - name: Wind Vortex
      description: Toon wind sheets wind upward in crescents, leaves cross the middle
        and dust from the ground is drawn into the column.
      display: 4
      prefab: {fileID: 2670856950670717536, guid: 5edac5ffe6f18ca4494f8e5760d9904d, type: 3}
      height: 1.4
      scale: 1
    - name: Ground Fog
      description: Thin mist spreads along the ground, drifting slowly. It can hide
        what lies low.
      display: 4
      prefab: {fileID: 2564869797351097598, guid: 43b39497c3a8fc043800ac184d154477, type: 3}
      height: 1.4
      scale: 1
    - name: Smoke Column
      description: Puffs of lit smoke rise, spreading and thinning as they climb.
      display: 4
      prefab: {fileID: 6190498436848697854, guid: 7ba453d7b9dc78b4893ece93722adfc8, type: 3}
      height: 1.4
      scale: 1
    - name: Steam Jet
      description: A narrow jet of steam shoots upward and breaks into mist at the
        top.
      display: 4
      prefab: {fileID: 8919332783194936454, guid: 9abc87a583fe758459778991a9a4d5f4, type: 3}
      height: 1.4
      scale: 1
    - name: Painterly Grass
      description: 'A patch of painted grass clumps grows from the ground, dotted
        with small white flowers. Tips and flowers sway in travelling gusts. Unlike
        the other effects this one is opaque scenery: it writes depth and draws in
        the Geometry queue.'
      display: 4
      prefab: {fileID: 763433529374101292, guid: 23bbd6949b607bc47884740c420b6b85, type: 3}
      height: 0
      scale: 1
    - name: Black Hole
      description: A black horizon with a burning halo hangs in the air, ringed by
        a painted accretion disk. Light streaks arc over it and spiral in, and everything
        behind it bends. The hole sits at 1.5 times `holeSize` above the origin,
        so the defaults make something 36 units wide with its centre 9 units up.
      display: 4
      prefab: {fileID: 1889343633268443362, guid: 96fffd049a16da94fb1206aca78e69e4, type: 3}
      height: 0
      scale: 0.2
    - name: Astral Gate
      description: A ring of sixteen glowing frame sections unfolds into an oval
        gate over a dark membrane of swirling light and stars. The gate faces +Z
        and its base sits near the origin.
      display: 4
      prefab: {fileID: 3443002842469634693, guid: 4b04c070b864e8545af3bd64253dbae4, type: 3}
      height: 0
      scale: 1
    - name: Astral Convergence
      description: Starlight circles inward, shrinks to one point, then bursts outward
        and leaves shining streaks.
      display: 4
      prefab: {fileID: 5555498362349441268, guid: 84ee307daefcf6e4db2d68b7197f155d, type: 3}
      height: 0
      scale: 1
    - name: Billowing Airburst
      description: A fireball bursts in mid-air behind a blinding flash and a shock
        ring. Thick jets of rolling fire shoot outward, with torn ribbons and long-tailed
        embers, then cool from white through orange to soot and erode away. Each
        cast picks new jets and a new noise offset.
      display: 4
      prefab: {fileID: 3725827330941288980, guid: acb07576964374c48af9088412ba6fc7, type: 3}
      height: 0
      scale: 1
    - name: Dimensional Rend
      description: Slashes of light cross the view one after another, windows of
        shifted background open along them, and at the release slices of the scene
        burst outward and hang in the air as they fade.
      display: 4
      prefab: {fileID: 8928022851258800894, guid: 6b29cc3858f2e204cad33693d78152ea, type: 3}
      height: 0
      scale: 1
    - name: Fire Explosion
      description: A rolling fireball bursts, its hot folds burn through to soot,
        and it leaves a cracked scorch, torn pressure bands, smoke trails and sparks.
        All the shapes are generated; nothing is a texture.
      display: 4
      prefab: {fileID: 3484876402305497061, guid: 1886b38a3d4afeb47b876a15aed5f80e, type: 3}
      height: 0
      scale: 1
    - name: Flame Surge
      description: Broad sheets of flame fold upward like a fan, and their edges
        scatter into small sparks.
      display: 4
      prefab: {fileID: 7362849580998074057, guid: bae885dbfcc7385498bd40f84f9f64be, type: 3}
      height: 0
      scale: 1
    - name: Ice Shatter
      description: A cluster of ice spikes lights up with cracks, then bursts into
        crystals and small flying chips.
      display: 4
      prefab: {fileID: 7929118984666715926, guid: 19c7c0da6d8c9ce448a4bedb4c2f156f, type: 3}
      height: 0
      scale: 1
    - name: Revival Bloom
      description: Two rings of petals gather, rise and open into a flower while
        seeds of light climb out of its heart.
      display: 4
      prefab: {fileID: 5812660426107342284, guid: 7baff684accdd9a4eb579c6db541664b, type: 3}
      height: 0
      scale: 1
    - name: Smoke Puff
      description: A puff of smoke swells fast, then clears. It suits appearing,
        vanishing or landing.
      display: 4
      prefab: {fileID: 2794334336319247219, guid: 2f522fc96b7f6e84497b340f651fce19, type: 3}
      height: 0
      scale: 1
    - name: Tidal Surge
      description: A wall of water pushes outward, its crest folds forward, and its
        edges break into foam and droplets.
      display: 4
      prefab: {fileID: 9154714808588638194, guid: 867e17b8dfa5d5349b9bcd990f757ff2, type: 3}
      height: 0
      scale: 1
  - name: Other
    objects: 0
    items:
    - name: Prism Guard
      description: Seven hexagonal crystal plates fold out into a curved wall in
        front of the origin, facing +Z, with faint glints drifting around it.
      display: 4
      prefab: {fileID: 7925706130765948013, guid: 53cad277b1d5e6b4294283ecad45f570, type: 3}
      height: 0
      scale: 1
    - name: Prism Parry
      description: A bright cross flashes where the hit lands, small crystal plates
        buckle and rebound, and shards and sparks scatter outward. The plates face
        +Z from the origin.
      display: 4
      prefab: {fileID: 6189094574717933934, guid: 2d0fb666029bf1549a174c17de81ccf6, type: 3}
      height: 0
      scale: 1
    - name: Impact Frame
      description: 'A 400 ms comic impact over the whole camera image: seven black
        and white beats of ink strokes, brush stars and a monochrome blast at the
        point of contact. It adds no game freeze, collision logic or camera work.'
      display: 5
      prefab: {fileID: 0}
      height: 0
      scale: 1
  - name: Weapons
    objects: 1
    items:
    - name: Energy Pistol
      description: A short gun has a glowing power pack and fires one blue-green
        light shot at a time.
      display: 6
      prefab: {fileID: 7769102928746215635, guid: f250364a482041046ae568708f23df67, type: 3}
      height: 0
      scale: 1
    - name: Pulse Rifle
      description: A long covered barrel fires three orange light shots each time.
      display: 6
      prefab: {fileID: 8452987625528909845, guid: 13360e173e35b7241bab84d92f2a9d59, type: 3}
      height: 0
      scale: 1
    - name: Battle Axe
      description: A curved axe blade sits on a wooden handle with a protective wrap.
      display: 6
      prefab: {fileID: 3494966885692054789, guid: 8dfc8066f76de0a4e95f06610b17df71, type: 3}
      height: 0
      scale: 1
    - name: Bow
      description: A curved wooden bow has a stitched grip and a string. It does
        not draw or shoot by itself.
      display: 6
      prefab: {fileID: 1649782856824514763, guid: 5583da7ce95d6cb4394344fc1c449c9d, type: 3}
      height: 0
      scale: 1
    - name: Dagger
      description: A short leaf-shaped blade has a handle held together by little
        pins.
      display: 6
      prefab: {fileID: 4559334617624639297, guid: cc4dbbbd45b5f34498620b4ecad0673f, type: 3}
      height: 0
      scale: 1
    - name: Energy Shield
      description: Several shield plates protect the front, with a handle and battery
        behind them.
      display: 6
      prefab: {fileID: 1625879081781414736, guid: ad39acab5d2bd0a46bc1829fc62cb6bb, type: 3}
      height: 0
      scale: 1
    - name: Handheld Scanner
      description: A grip supports a small screen and probe for exploration scenes.
      display: 6
      prefab: {fileID: 5790013104358413211, guid: 81591c63641027b4796321fb48320951, type: 3}
      height: 0
      scale: 1
    - name: Lightweight Sword
      description: "A pale slender blade, blue guard and dark grip\u2014the same
        sword used in slash previews."
      display: 6
